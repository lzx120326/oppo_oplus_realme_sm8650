diff --git a/fs/proc/spoof_version.c b/fs/proc/spoof_version.c
new file mode 100644
--- /dev/null
+++ b/fs/proc/spoof_version.c
@@ -0,0 +1,39 @@
+/*
+ * spoof_version.c - /proc/version 伪装（内置版）
+ * 目的: 隐藏"内核被KSU/SUSFS/自定义修改"的痕迹, 伪装成与真机一致的原版内核字符串
+ * 安全: 纯静态数据替换, 无内存操作, proc 标准接口
+ * 注意: 建议按你手机刷ABK前记录的"原版 /proc/version"修改下面的字符串, 与真机一致最无痕
+ */
+#include <linux/kernel.h>
+#include <linux/init.h>
+#include <linux/proc_fs.h>
+#include <linux/fs.h>
+#include <linux/uaccess.h>
+
+static const char fake_version[] =
+"Linux version 6.1.141-android14-11-o-g16e6ef702577 (build@kvm-slave) (clang version 17.0.2) #1 SMP PREEMPT Tue Apr 14 16:00:22 CST 2026\n";
+
+static ssize_t spoof_version_read(struct file *file, char __user *buf, size_t count, loff_t *ppos)
+{
+    return simple_read_from_buffer(buf, count, ppos, fake_version, sizeof(fake_version) - 1);
+}
+
+static const struct proc_ops spoof_version_ops = {
+    .proc_read = spoof_version_read,
+    .proc_lseek = default_llseek,
+};
+
+static int __init spoof_version_init(void)
+{
+    remove_proc_entry("version", NULL);
+
+    if (!proc_create("version", 0444, NULL, &spoof_version_ops)) {
+        pr_err("spoof: version proc_create failed\n");
+        return -ENOMEM;
+    }
+
+    pr_info("spoof: /proc/version hijacked (builtin)\n");
+    return 0;
+}
+
+late_initcall(spoof_version_init);

